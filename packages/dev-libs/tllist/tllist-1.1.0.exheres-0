require meson [ meson_minimum_version=0.54.0 ]

SUMMARY="A C header file only implementation of a typed linked list"
HOMEPAGE="https://codeberg.org/dnkl/${PN}"
DOWNLOADS="${HOMEPAGE}/archive/${PV}.tar.gz -> ${PNV}.tar.gz"

LICENCES="MIT"
SLOT="0"
PLATFORMS="~amd64 ~armv8"
MYOPTIONS=""

DEPENDENCIES=""

MESON_SOURCE="${WORKBASE}"/${PN}

src_install() {
    meson_src_install

    edo mv \
        "${IMAGE}"/usr/share/doc/${PN}/* \
        "${IMAGE}"/usr/share/doc/${PNVR}/
    edo rmdir \
        "${IMAGE}"/usr/share/doc/${PN}
}

