+// librsvg < 2.46 has neither RsvgRectangle nor rsvg_handle_render_document.
+// Emulate the viewport by scaling the cairo CTM before rendering instead.
+static bool renderSvgDocument(RsvgHandle* handle, cairo_t* cairo, const Vector2D& size) {
+#if LIBRSVG_CHECK_VERSION(2, 46, 0)
+    GError*       error = nullptr;
+    RsvgRectangle rect  = {0, 0, (double)size.x, (double)size.y};
+
+    return rsvg_handle_render_document(handle, cairo, &rect, &error);
+#else
+    RsvgDimensionData dim;
+    rsvg_handle_get_dimensions(handle, &dim);
+
+    if (dim.width <= 0 || dim.height <= 0)
+        return false;
+
+    cairo_save(cairo);
+
+    const double SCALE = std::min((double)size.x / dim.width, (double)size.y / dim.height);
+    cairo_translate(cairo, (size.x - dim.width * SCALE) / 2.0, (size.y - dim.height * SCALE) / 2.0);
+    cairo_scale(cairo, SCALE, SCALE);
+
+    const bool RENDERED = rsvg_handle_render_cairo(handle, cairo);
+
+    cairo_restore(cairo);
+
+    return RENDERED;
+#endif
+}
