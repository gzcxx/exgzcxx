Upstream: no
From 7c48bc2d2352bcf53d0e28f5c175a8b1527311f8 Mon Sep 17 00:00:00 2001
From: Quentin Glidic <sardemff7+git@sardemff7.net>
Date: Sun, 26 Apr 2015 19:02:29 +0200
Subject: [PATCH] Allow to force-disable the GTK+3 dependency

Signed-off-by: Quentin Glidic <sardemff7+git@sardemff7.net>
---
 Makefile.am  |  2 +-
 configure.ac | 25 ++++++++++++++++++-------
 2 files changed, 19 insertions(+), 8 deletions(-)

diff --git a/Makefile.am b/Makefile.am
index 341b557..def94b4 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -6,7 +6,7 @@ BUILT_SOURCES =
 lib_LTLIBRARIES = librsvg-@RSVG_API_MAJOR_VERSION@.la
 
 bin_PROGRAMS = rsvg-convert
-if HAVE_GTK_3
+if ENABLE_VIEWER
 bin_PROGRAMS += rsvg-view-3
 endif
 
diff --git a/configure.ac b/configure.ac
index bf77f3a..68b13b2 100644
--- a/configure.ac
+++ b/configure.ac
@@ -128,17 +128,28 @@ AC_CHECK_FUNCS(strtok_r)
 # GTK
 # ===========================================================================
 
-PKG_CHECK_MODULES([GTK3],[gtk+-3.0 >= $GTK3_REQUIRED],[have_gtk_3=yes],[have_gtk_3=no])
+AC_MSG_CHECKING([whether to build the GTK+3/RSVG based SVG viewer])
+AC_ARG_ENABLE([viewer],
+  [AS_HELP_STRING([--disable-viewer],[Disable the GTK+3/RSVG based SVG viewer (default=auto)])],
+  [],[enable_viewer=auto])
 
-GTK3_BINARY_VERSION=
+if test "$enable_viewer" != no; then
+    PKG_CHECK_MODULES([GTK3],[gtk+-3.0 >= $GTK3_REQUIRED],[have_gtk_3=yes],[have_gtk_3=no])
 
-if test "$have_gtk_3" = "yes"; then
-    GTK3_BINARY_VERSION="`$PKG_CONFIG --variable=gtk_binary_version gtk+-3.0`"
-fi
+    GTK3_BINARY_VERSION=
+
+    if test "$have_gtk_3" = "yes"; then
+        GTK3_BINARY_VERSION="`$PKG_CONFIG --variable=gtk_binary_version gtk+-3.0`"
+        enable_viewer=yes
+    elif test "$enable_viewer" = "yes"; then
+        AC_MSG_ERROR([GTK+3 required to build the SVG viewer])
+    fi
 
-AC_SUBST([GTK3_BINARY_VERSION])
+    AC_SUBST([GTK3_BINARY_VERSION])
+fi
+AC_MSG_RESULT([$enable_viewer])
 
-AM_CONDITIONAL([HAVE_GTK_3],[test "$have_gtk_3" = "yes"])
+AM_CONDITIONAL([ENABLE_VIEWER],[test "$enable_viewer" = "yes"])
 
 dnl ===========================================================================
 dnl GDK-Pixbuf SVG loader
-- 
2.0.1


