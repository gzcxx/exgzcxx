require github [ user=hluk tag=v${PV} ]
require cmake

SUMMARY="Clipboard manager with advanced features"
HOMEPAGE="https://hluk.github.io/CopyQ/"
LICENCES="GPL-3.0"
SLOT="0"
PLATFORMS="~amd64"

MYOPTIONS="
    jemalloc [[ description = [ Use jemalloc as the allocator ] ]]
"
CMAKE_BUILD_DIR="${WORKBASE}"/build
CMAKE_SOURCE="${WORKBASE}/${PNV}"

DEPENDENCIES="
    build:
        virtual/pkg-config
        sys-libs/wayland-protocols
        sys-devel/ninja
    build+run:
        jemalloc? ( dev-libs/jemalloc )
        dev-libs/libglvnd
        x11-libs/libXext
        x11-libs/libXtst
        x11-libs/libICE
        x11-libs/libX11
        sys-libs/wayland
        x11-libs/qtbase:6[gui]
        x11-libs/qtdeclarative:6
        x11-libs/qtsvg:6
        x11-libs/qtwayland:6
        
"

CMAKE_SRC_CONFIGURE_PARAMS=(
    -GNinja
    -DWITH_PLUGINS:BOOL=FALSE
    -DWITH_QCA_ENCRYPTION:BOOL=FALSE
    -DWITH_GNOME_CLIPBOARD_EXTENSION:BOOL=FALSE
    -DWITH_AUDIO:BOOL=FALSE
    -DWITH_NATIVE_NOTIFICATIONS:BOOL=FALSE
)

