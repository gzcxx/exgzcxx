require cmake [ api=2 ]
SUMMARY="Hyprland is a 100% independent, dynamic tiling Wayland compositor that doesn't sacrifice on its looks."
HOMEPAGE="https://github.com/hyprwm/Hyprland"
DOWNLOADS="https://github.com/hyprwm/Hyprland/releases/download/v${PV}/source-v${PV}.tar.gz -> ${PNV}.tar.gz"

CMAKE_SOURCE="${WORKBASE}/hyprland-source"

LICENCES="BSD-3"
SLOT="0"
PLATFORMS="~amd64"
MYOPTIONS=""

DEFAULT_SRC_PREPARE_PATCHES=(
	"${FILES}/0001-ranges.patch"
)

DEPENDENCIES="
    build+run:
        x11-dri/mesa
        dev-lang/glslang
        dev-libs/glaze
        dev-libs/aquamarine
        dev-libs/hyprcursor
        dev-libs/hyprgraphics
        dev-libs/hyprlang
        dev-libs/hyprutils
        dev-util/hyprwayland-scanner
        dev-libs/glib:2
        dev-libs/re2
        sys-apps/util-linux
        sys-libs/libinput
        sys-libs/wayland-protocols
        sys-libs/wayland
        x11-dri/libdrm
        x11-libs/cairo
        x11-libs/libxcb
        x11-libs/libXcursor
        x11-libs/libxkbcommon
        x11-libs/pango
        x11-libs/pixman:1
        x11-utils/xcb-util-errors
        x11-utils/xcb-util-wm
        dev-libs/libei
	dev-libs/muparser
	dev-lang/lua:5.5
"

