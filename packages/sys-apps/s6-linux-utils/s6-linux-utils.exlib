require flag-o-matic

export_exlib_phases src_prepare src_configure src_install

SUMMARY="s6-linux-utils is a set of minimalistic Linux-specific system utilities"
HOMEPAGE="http://skarnet.org/software/${PN}/"
if ever is_scm; then
    SCM_REPOSITORY="git://git.skarnet.org/${PN}"
    SCM_BRANCH=main
    require scm-git
else
    DOWNLOADS="http://skarnet.org/software/${PN}/${PNV}.tar.gz"
fi

LICENCES="ISC"
SLOT="0"
MYOPTIONS="
    nsss [[ description = [ Use the nsss library for user database lookups ] ]]
    static
"

DEPENDENCIES=""

DEFAULT_SRC_COMPILE_PARAMS=(
    CROSS_COMPILE=$(exhost --tool-prefix)
)

s6-linux-utils_src_prepare()
{
    default

    edo sed 's/0700/0755/g' -i package/modes
}

s6-linux-utils_src_configure()
{
    optionq nsss && append-flags -I/usr/$(exhost --target)/include/nsss

    local args=(
        --disable-rpath
        --enable-pkgconfig
        --enable-shared
        --with-lib=/usr/$(exhost --target)/lib
        --with-dynlib=/usr/$(exhost --target)/lib
        --with-pkgconfig
        $(option_enable nsss)
        $(option_enable static allstatic)
    )

    [[ $(exhost --target) == *-gnu* ]] || \
        args+=( $(option_enable static static-libc) )

    econf "${args[@]}"
}

s6-linux-utils_src_install()
{
    default

    insinto /usr/share/doc/${PNVR}/html
    doins doc/*
}

